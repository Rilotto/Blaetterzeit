{
  "name": "blaetterzeit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run --reporter=default --reporter=json --outputFile=test-results.json",
    "test:watch": "vitest",
    "trace": "node scripts/check-traceability.mjs",
    "trace:write": "node scripts/check-traceability.mjs --write",
    "verify": "npm run typecheck && npm run lint && npm test && npm run trace",
    "release:freeze": "node scripts/release-freeze.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "preview": "vite preview",
    "verify:grob": "tsc -b && oxlint --quiet && node scripts/test-grob.mjs && node scripts/check-traceability.mjs --grob"
  },
  "dependencies": {
    "@capacitor-community/camera-preview": "^8.0.2",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
